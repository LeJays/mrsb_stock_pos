rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "jameswalter695@gmail.com" ||
        request.auth.token.email == "contact@mrsb.com" ||
        request.auth.token.email == "admin@mrsb.com" ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isCashier() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'caisse';
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /sorties/{sortieId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /entrees/{entreeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /cash_register/{registerId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
    }
  }
}
